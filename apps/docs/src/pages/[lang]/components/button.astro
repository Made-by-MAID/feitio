---
import Button from '@feitio/astro/Button.astro';
import Example from '../../../components/Example.astro';
import { BUTTON } from '../../../content/button.ts';
import { componentsNav } from '../../../content/nav.ts';
import { LOCALES, type Locale } from '../../../i18n/ui.ts';
import DocPage from '../../../layouts/DocPage.astro';
import { renderHtml } from '../../../lib/render.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = BUTTON[lang];
const base = import.meta.env.BASE_URL;
const examples = [
  {
    id: 'primary',
    text: t.primary,
    html: await renderHtml(Button, { variant: 'primary' }, t.primary[2]),
  },
  { id: 'default', text: t.plain, html: await renderHtml(Button, {}, t.plain[2]) },
  {
    id: 'danger',
    text: t.danger,
    html: await renderHtml(Button, { variant: 'danger' }, t.danger[2]),
  },
  {
    id: 'sizes',
    text: t.sizes,
    html: `${await renderHtml(Button, { size: 'small' }, t.sizes[2])}\n${await renderHtml(Button, { size: 'large' }, t.sizes[3])}`,
  },
  {
    id: 'link',
    text: t.link,
    html: await renderHtml(Button, { href: `${base}${lang}/dev/`, variant: 'primary' }, t.link[2]),
  },
];
const toc = [
  { id: 'when', text: t.when[0] },
  { id: 'when-not', text: t.whenNot[0] },
  {
    id: 'examples',
    text: t.examples,
    children: examples.map((e) => ({ id: e.id, text: e.text[0] })),
  },
  { id: 'a11y', text: t.a11y[0] },
  { id: 'attributes', text: t.attrs[0] },
];
---
<DocPage lang={lang} title="Button" area="comp" nav={componentsNav(lang, base, 'Button')} toc={toc} lede={t.lede} searchArea={t.area}>
  <h2 id="when">{t.when[0]}</h2>
  <ul>{t.when[1].map((i) => <li set:html={i} />)}</ul>
  <h2 id="when-not">{t.whenNot[0]}</h2>
  <ul>{t.whenNot[1].map((i) => <li set:html={i} />)}</ul>
  <h2 id="examples">{t.examples}</h2>
  <div class="feitio-stack" data-gap="4">
    {examples.map((e) => <Example id={e.id} title={e.text[0]} description={e.text[1]} html={e.html} lang={lang} />)}
  </div>
  <h2 id="a11y">{t.a11y[0]}</h2>
  <ul>{t.a11y[1].map((i) => <li set:html={i} />)}</ul>
  <h2 id="attributes">{t.attrs[0]}</h2>
  <dl class="attrs">{t.attrs[1].map(([name, what]) => <div><dt><code>{name}</code></dt><dd>{what}</dd></div>)}</dl>
</DocPage>
