---
/** The root sends each visitor to their language, or Portuguese. */
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Feitio</title>
<meta http-equiv="refresh" content={`0; url=${base}pt/`}>
<script is:inline define:vars={{ base }}>
  const want = (navigator.languages || [navigator.language || 'pt']).map((l) => l.slice(0, 2).toLowerCase());
  const lang = want.find((l) => ['pt', 'en', 'es', 'fr', 'de'].includes(l)) || 'pt';
  location.replace(`${base}${lang}/`);
</script>
</head>
<body><p><a href={`${base}pt/`}>Feitio</a></p></body>
</html>
