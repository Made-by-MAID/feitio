---
/** CodeBlock: code with colors and the Copy button, which says "Copied" in place. */
import Icon from '@feitio/astro/Icon.astro';
import { type Locale, WORDS } from '../i18n/ui.ts';

interface Props {
  code: string;
  lang: Locale;
  label?: string;
  syntax?: 'html' | 'jsx' | 'shell';
}
const { code, lang, label = 'HTML', syntax = 'html' } = Astro.props;
const words = WORDS[lang];
const sprite = `${import.meta.env.BASE_URL}feitio/icons/sprite.svg`;
---
<div class="feitio-code" data-lang={syntax}>
  <div class="bar"><span>{label}</span><button type="button" class="feitio-button copy" data-size="small" data-done-label={words.copied}>{words.copy}</button></div>
  <pre><code>{code}</code></pre>
</div>
