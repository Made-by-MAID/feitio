{
  "name": "@feitio/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-core": "rm -rf public/feitio && mkdir -p public/feitio && cp -R ../../packages/core/icons ../../packages/core/illustrations public/feitio/",
    "dev": "bun run copy-core && astro dev",
    "build": "bun run copy-core && astro build && pagefind --site dist && bun scripts/markdown.ts && bun scripts/og.ts",
    "preview": "astro preview"
  },
  "dependencies": {
    "@feitio/astro": "workspace:*",
    "@feitio/core": "workspace:*",
    "@feitio/vanilla": "workspace:*",
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "lighthouse": "13.6.0",
    "linkedom": "0.18.15",
    "pagefind": "1.6.0",
    "satori": "0.63.2",
    "turndown": "7.2.5"
  }
}
