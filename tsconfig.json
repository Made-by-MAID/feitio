{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/parity/**/*",
    "packages/*/scripts/**/*",
    "scripts/**/*",
    "e2e/**/*"
  ]
}
