{
  "name": "@feitio/core",
  "version": "0.1.0",
  "description": "Feitio's foundation: design tokens, the layered base CSS, the hand-drawn icons and illustrations.",
  "keywords": [
    "feitio",
    "design-system",
    "accessibility",
    "a11y",
    "handmade",
    "design-tokens",
    "css",
    "css-variables",
    "icons",
    "dark-mode",
    "themes"
  ],
  "homepage": "https://made-by-maid.github.io/feitio/",
  "bugs": {
    "url": "https://github.com/Made-by-MAID/feitio/issues"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Made-by-MAID/feitio.git",
    "directory": "packages/core"
  },
  "files": [
    "tokens",
    "css",
    "fonts",
    "js",
    "icons",
    "illustrations"
  ],
  "exports": {
    "./css/*": "./css/*",
    "./js/tokens.ts": "./js/tokens.ts",
    "./icons/*": "./icons/*",
    "./illustrations/*": "./illustrations/*",
    "./tokens/*": "./tokens/*",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "bun src/flows/build-tokens.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
