{
  "$description": "Feitio base tokens: what every theme shares. Colors live in the themes.",
  "font": {
    "$type": "fontFamily",
    "text": {
      "$value": ["Alegreya", "Georgia", "serif"],
      "$description": "Long text, for reading."
    },
    "ui": {
      "$value": ["Alegreya Sans", "Gill Sans", "sans-serif"],
      "$description": "Headings and everything you act on: buttons, tables, forms."
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "bold": { "$value": 700 },
    "heavy": { "$value": 800 }
  },
  "font-size": {
    "$type": "dimension",
    "small": {
      "$value": { "value": 1, "unit": "rem" },
      "$description": "Captions, field help, footers."
    },
    "body": { "$value": { "value": 1.25, "unit": "rem" } },
    "h3": { "$value": { "value": 1.5, "unit": "rem" } },
    "h2": { "$value": { "value": 2, "unit": "rem" } },
    "h1": { "$value": { "value": 2.75, "unit": "rem" } },
    "display": { "$value": { "value": 4, "unit": "rem" } }
  },
  "line-height": {
    "$type": "number",
    "text": { "$value": 1.6 },
    "heading": { "$value": 1.08 }
  },
  "space": {
    "$type": "dimension",
    "$description": "One ruler for every gap, from an icon next to a word to the air between sections.",
    "1": { "$value": { "value": 0.25, "unit": "rem" }, "$description": "Icon and word." },
    "2": { "$value": { "value": 0.5, "unit": "rem" }, "$description": "Inside a control." },
    "3": { "$value": { "value": 1, "unit": "rem" }, "$description": "Between items of a list." },
    "4": { "$value": { "value": 1.5, "unit": "rem" }, "$description": "Inside a block." },
    "5": { "$value": { "value": 2.5, "unit": "rem" }, "$description": "Padding of a block." },
    "6": { "$value": { "value": 4, "unit": "rem" }, "$description": "Between blocks." },
    "7": { "$value": { "value": 6, "unit": "rem" }, "$description": "Between sections." }
  },
  "measure": {
    "$type": "dimension",
    "reading": {
      "$value": { "value": 46, "unit": "rem" },
      "$description": "The widest a reading column gets."
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Slightly uneven corners, like paper cut by hand: each corner has its own radius.",
    "top-left": { "$value": { "value": 6, "unit": "px" } },
    "top-right": { "$value": { "value": 10, "unit": "px" } },
    "bottom-right": { "$value": { "value": 6, "unit": "px" } },
    "bottom-left": { "$value": { "value": 8, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "width": {
      "$value": { "value": 1, "unit": "px" },
      "$description": "The ink line of controls and lifted paper: fine, like a pen stroke."
    }
  },
  "focus": {
    "$type": "dimension",
    "width": { "$value": { "value": 3, "unit": "px" } },
    "offset": { "$value": { "value": 3, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "lift": {
      "$value": {
        "color": "{color.shadow}",
        "offsetX": { "value": 5, "unit": "px" },
        "offsetY": { "value": 6, "unit": "px" },
        "blur": { "value": 0, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      },
      "$description": "Lifted paper: a hard shadow, offset, never blurred."
    }
  },
  "duration": {
    "$type": "duration",
    "place": {
      "$value": { "value": 260, "unit": "ms" },
      "$description": "Paper being placed: how long a menu or a notice takes to settle."
    },
    "change": {
      "$value": { "value": 320, "unit": "ms" },
      "$description": "Any change of state: day to night, density, hover, a size that grows. Nothing jumps."
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "place": { "$value": [0.2, 0.9, 0.3, 1.25], "$description": "Settles with a small overshoot." },
    "change": {
      "$value": [0.3, 0, 0.2, 1],
      "$description": "Starts gently and lands softly, with no overshoot."
    }
  }
}
