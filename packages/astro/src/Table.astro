---
/**
 * Table: many things of the same kind, to compare. On a phone each row becomes a card, the column
 * names beside each value. The caption names the scrolling region; actions go in the last column.
 */
interface Props {
  id: string;
  caption?: string;
  columns: { label: string; align?: 'end'; hidden?: boolean }[];
  /** Each row: one cell per column, as HTML (a Tag, a link, a button). */
  rows: string[][];
  /** The first column is the row's title on a phone card. */
  compact?: boolean;
}
const { id, caption, columns, rows, compact } = Astro.props;
const cap = `${id}-cap`;
---
<div data-density={compact ? 'compact' : undefined} style="inline-size: 100%">
  <div class="feitio-table-scroll" tabindex="0" role="region" aria-labelledby={caption ? cap : undefined} aria-label={caption ? undefined : columns[0]?.label}>
    <table class="feitio-table">
      {caption && <caption id={cap}>{caption}</caption>}
      <thead><tr>{columns.map((c) => <th scope="col" data-align={c.align}>{c.hidden ? <span class="feitio-visually-hidden">{c.label}</span> : c.label}</th>)}</tr></thead>
      <tbody>{rows.map((r) => <tr>{r.map((cell, i) => i === 0 ? <td class="title" set:html={cell} /> : columns[i]?.hidden ? <td class="actions" set:html={cell} /> : <td data-align={columns[i]?.align} data-label={columns[i]?.label} set:html={cell} />)}</tr>)}</tbody>
    </table>
  </div>
</div>
