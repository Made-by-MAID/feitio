---
/** Example: the live example, with its code underneath, closed until asked. The slot is the live part. */
import CodeBlock from './CodeBlock.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  code: string;
  showLabel?: string;
  copyLabel?: string;
  copiedLabel?: string;
  sprite?: string;
}
const {
  id,
  title,
  description,
  code,
  showLabel = 'Mostrar código',
  copyLabel,
  copiedLabel,
  sprite,
} = Astro.props;
---
<div class="feitio-example"><div class="live"><slot /></div><div class="about"><h3 id={id}>{title}</h3><p>{description}</p><details><summary><Icon name="chevron-right" sprite={sprite} />{showLabel}</summary><CodeBlock code={code} copyLabel={copyLabel} copiedLabel={copiedLabel} /></details></div></div>
