---
/** Heading: the title of a page or a section. The level is the outline (h1 to h4); the look comes from the base CSS. */
interface Props {
  level?: 1 | 2 | 3 | 4;
  id?: string;
}
const { level = 2, id } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
---
<Tag id={id}><slot /></Tag>
