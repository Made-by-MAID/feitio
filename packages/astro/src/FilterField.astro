---
/**
 * FilterField: filters the list below as the person types, and says how many are left. Off by
 * default: debounce (ms) waits for the typing to stop, with a line filling under the field; async
 * hands the search to the page (a feitio-filter event with the query and done()), turning a stroke
 * inside the field until the results are in.
 */
interface Props {
  id: string;
  /** The id of the list it filters; each item carries data-search. */
  list: string;
  label: string;
  placeholder?: string;
  debounce?: number;
  async?: boolean;
  /** What the count says while an asynchronous search runs. */
  busyLabel?: string;
}
const {
  id,
  list,
  label,
  placeholder,
  debounce,
  async: isAsync,
  busyLabel = 'Buscando…',
} = Astro.props;
---
<div class="feitio-filter"><label class="feitio-visually-hidden" for={id}>{label}</label><span class="box"><input class="feitio-input" id={id} type="search" autocomplete="off" placeholder={placeholder} data-filter={list} data-debounce={debounce} data-async={isAsync ? '' : undefined} data-busy-label={isAsync ? busyLabel : undefined} /><span class="wait" aria-hidden="true"></span><svg class="busy" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M12 3.4C16.9 3.2 20.7 7.1 20.6 12C20.5 16.7 16.7 20.6 12 20.6C7.2 20.6 3.4 16.8 3.4 12.1C3.4 7.6 6.9 3.9 11.4 3.5" /></svg></span><span class="count" data-count={list} aria-live="polite"></span></div>
