---
/** Anchor: the page index, following the scroll; the current part in ink, with the hand-drawn arrow. */
import Icon from './Icon.astro';

interface Props {
  title?: string;
  items: {
    id: string;
    text: string;
    current?: boolean;
    children?: { id: string; text: string; current?: boolean }[];
  }[];
  label?: string;
  sprite?: string;
}
const { title, items, label, sprite } = Astro.props;
---
<nav class="feitio-anchor" aria-label={label ?? title}>{title && <p class="title">{title}</p>}<ul>{items.map((t) => <li><a href={`#${t.id}`} aria-current={t.current ? 'location' : undefined}><Icon name="chevron-right" sprite={sprite} />{t.text}</a>{t.children && <ul>{t.children.map((c) => <li><a href={`#${c.id}`} aria-current={c.current ? 'location' : undefined}><Icon name="chevron-right" sprite={sprite} />{c.text}</a></li>)}</ul>}</li>)}</ul></nav>
