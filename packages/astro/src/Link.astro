---
/**
 * Link: takes you to another page. newTab opens another tab, only when leaving would lose
 * something, and always says so: the icon, and the words for screen readers.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  newTab?: boolean;
  /** What screen readers hear after the text when it opens in a new tab. */
  newTabLabel?: string;
  sprite?: string;
}
const { href, newTab = false, newTabLabel = '(abre em nova aba)', sprite } = Astro.props;
---
<a class="feitio-link" href={href} target={newTab ? '_blank' : undefined} rel={newTab ? 'noopener' : undefined}><slot />{newTab && <Icon name="new-tab" sprite={sprite} />}{newTab && <span class="feitio-visually-hidden"> {newTabLabel}</span>}</a>
